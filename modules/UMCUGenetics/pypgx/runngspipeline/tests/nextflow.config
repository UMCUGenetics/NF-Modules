params {
    star_allele_base    = "/Users/jsteenbr/tools/PGx_tables/"
    pypgx_allele_table  = "${params.star_allele_base}/allele-table.csv"
    pypgx_variant_table = "${params.star_allele_base}/variant-table.csv"
    pypgx_gene_table    = "${params.star_allele_base}/gene-table.csv"
    pypgx_diplotype_table = "${params.star_allele_base}/diplotype-table.csv"
}

process {
    withName: "PYPGX_RUNNGSPIPELINE" {
        ext.args = {"--assembly GRCh38"}

        containerOptions = {
            [
                "-v ${params.pypgx_allele_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/allele-table.csv",
                "-v ${params.pypgx_variant_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/variant-table.csv",
                "-v ${params.pypgx_gene_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/gene-table.csv",
                "-v ${params.pypgx_diplotype_table}:/usr/local/lib/python3.12/site-packages/pypgx/api/data/diplotype-table.csv"
            ].join(' ').trim()
        }

    }

}
